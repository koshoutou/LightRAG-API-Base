# ============================================================================
# LightRAG-API-Base 环境变量示例
# 复制为 .env 后按实际填写。.env 已被 .gitignore 排除，不会被提交。
# 警告：切勿将真实密钥提交到仓库。本文件仅作占位示范。
# ============================================================================

# --- 运行时 ---
# 管理员初始化令牌（首次启动引导用，登录管理后台 /api/admin 引导页）
# 建议部署后立即在管理后台轮换。留空则需通过 CLI 或 DB 手动初始化。
ADMIN_BOOTSTRAP_TOKEN=

# JWT 签名密钥（管理后台会话签发；随机长字符串，勿外泄）
JWT_SECRET=change-me-to-a-long-random-string

# 服务监听端口（next dev / next start 使用）
PORT=3001

# --- Qdrant 连接（只读检索目标；本网关不直接写库）---
QDRANT_URL=
QDRANT_API_KEY=

# --- Embedding 模型（OpenAI 兼容 /v1/embeddings）---
# 重要：必须与向量入库时使用的嵌入服务/模型完全一致，否则向量空间不匹配，
# 召回结果将无意义。入库侧请以 LightRAG-Base 知识库设置中的 embedApiBase/embedModel 为准。
EMBED_API_BASE=
EMBED_API_KEY=
EMBED_MODEL=

# --- Rerank 模型（OpenAI 兼容 /v1/rerank）---
# 重要：必须与入库/检索侧使用的重排模型一致，否则重排序结果不可对比。
RERANK_API_BASE=
RERANK_API_KEY=
RERANK_MODEL=

# --- 元数据库（审计日志 / 计量 / 租户 / API Key 等管理面数据）---
DATABASE_URL=file:./db/audit.db
